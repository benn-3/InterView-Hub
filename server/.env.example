# ==============================================================
# Interview Hub Backend Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control!
# ==============================================================

# Server Port
PORT=5001

# Application Environment (development | production)
NODE_ENV=development

# MongoDB Atlas Connection URI
# Provided in your MongoDB Atlas cluster: Deployment -> Database -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/interview_guide?retryWrites=true&w=majority

# Google OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Express Session Secret Key (Must be at least 32 cryptographically secure characters)
SESSION_SECRET=replace_with_a_secure_random_session_secret_at_least_32_characters

# Allowed Frontend URLs for CORS and Cookie configuration
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
