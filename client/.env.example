# Google OAuth 2.0 Web Client ID
# Must match the GOOGLE_CLIENT_ID used in server/.env and authorized in Google Cloud Console
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend API Base URL (Render Server URL)
VITE_API_BASE_URL=https://interview-hub-1-1dah.onrender.com/api

# Backend Server Host (for local Vite dev proxy)
VITE_BACKEND_URL=https://interview-hub-1-1dah.onrender.com
