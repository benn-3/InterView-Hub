# Google OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Application Type: Web application)
# Must match the GOOGLE_CLIENT_ID used in server/.env
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend API Base URL (leave empty or /api to use Vite reverse proxy during local development)
VITE_API_BASE_URL=/api
